{
  "rules": {
    ".read": false,
    ".write": false,

    "admin_claims": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'ADMIN'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'ADMIN'"
    },

    "users": {
      ".indexOn": ["email", "role", "status"],
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || (query.orderByChild == 'email' && query.equalTo == auth.token.email))",
      "$campus_user_id": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || auth.token.email === data.child('email').val() || data.child('userId').val() === auth.uid || $campus_user_id === auth.uid)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || (!data.exists() && (auth.token.email === newData.child('email').val() || newData.child('userId').val() === auth.uid || $campus_user_id === auth.uid)) || (data.exists() && (auth.token.email === data.child('email').val() || data.child('userId').val() === auth.uid || $campus_user_id === auth.uid)))",
        ".validate": "newData.hasChildren(['userId', 'fullName', 'email', 'role'])",

        "userId": {
          ".validate": "newData.val() === $campus_user_id && (newData.val().length === 16 || newData.val().length === 19 || newData.val().length > 0)"
        },
        "fullName": {
          ".validate": "newData.isString()"
        },
        "username": {
          ".validate": "newData.isString()"
        },
        "email": {
          ".validate": "!data.exists() || data.val() === newData.val()"
        },
        "role": {
          ".validate": "(newData.val() === 'STUDENT' || newData.val() === 'VENDOR' || newData.val() === 'STANDARD' || newData.val() === 'ADMIN') && (!data.exists() || data.val() === newData.val() || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')"
        },
        "passwordHash": {
          ".validate": "newData.val() === '[FIREBASE_SSO]' || newData.isString()"
        },
        "walletBalance": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "status": {
          ".validate": "!data.exists() || data.val() === newData.val() || root.child('users').child(auth.uid).child('role').val() === 'ADMIN'"
        },
        "shopName": {
          ".validate": "!newData.exists() || newData.val() == null || newData.isString()"
        },
        "shopStatus": {
          ".validate": "!newData.exists() || newData.val() == null || newData.isString()"
        },
        "bankAccountInfo": {
          ".validate": "!newData.exists() || newData.val() == null || newData.isString()"
        },
        "registrationDate": {
          ".validate": "!newData.exists() || newData.val() == null || newData.isNumber()"
        },
        "usercode": {
          ".validate": "!newData.exists() || newData.val() == null || newData.isString()"
        }
      }
    },

    "orders": {
      ".indexOn": ["customerId", "vendorId", "status", "timestamp"],
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || (query.orderByChild == 'customerId' && query.equalTo == auth.uid) || (query.orderByChild == 'vendorId' && query.equalTo == auth.uid))",
      "$order_id": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || data.child('customerId').val() === auth.uid || data.child('vendorId').val() === auth.uid || data.child('customerId').val() === auth.token.email || data.child('vendorId').val() === auth.token.email)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || (!data.exists() && (newData.child('customerId').val() === auth.uid || newData.child('customerId').val() === auth.token.email)) || (data.exists() && (data.child('customerId').val() === auth.uid || data.child('vendorId').val() === auth.uid || data.child('customerId').val() === auth.token.email || data.child('vendorId').val() === auth.token.email)))",
        ".validate": "newData.hasChildren(['orderId', 'customerId', 'vendorId', 'totalAmount', 'status'])",

        "orderId": {
          ".validate": "newData.val() === $order_id"
        },
        "customerId": {
          ".validate": "newData.isString()"
        },
        "vendorId": {
          ".validate": "newData.isString()"
        },
        "itemsJson": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "totalAmount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "status": {
          ".validate": "newData.isString()"
        },
        "paymentMethod": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "pickupTime": {
          ".validate": "!newData.exists() || newData.val() == null || newData.isString() || newData.isNumber()"
        },
        "specialRequests": {
          ".validate": "!newData.exists() || newData.val() == null || newData.isString()"
        },
        "timestamp": {
          ".validate": "!newData.exists() || newData.isNumber()"
        }
      }
    },

    "feedback": {
      ".indexOn": ["userId", "type", "status", "createdAt"],
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || (query.orderByChild == 'userId' && query.equalTo == auth.uid))",
      "$feedback_id": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || data.child('userId').val() === auth.uid)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || (!data.exists() && newData.child('userId').val() === auth.uid) || (data.exists() && (data.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')))",
        ".validate": "newData.hasChildren(['userId', 'type', 'subject', 'message', 'userName', 'userEmail', 'status', 'createdAt', 'updatedAt'])",

        "userId": {
          ".validate": "newData.isString()"
        },
        "type": {
          ".validate": "newData.val() === 'complaint' || newData.val() === 'compliment'"
        },
        "subject": {
          ".validate": "newData.isString()"
        },
        "message": {
          ".validate": "newData.isString()"
        },
        "userName": {
          ".validate": "newData.isString()"
        },
        "userEmail": {
          ".validate": "newData.isString()"
        },
        "status": {
          ".validate": "newData.val() === 'pending' || newData.val() === 'resolved'"
        },
        "createdAt": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "updatedAt": {
          ".validate": "newData.isString() && newData.val().length > 0"
        }
      }
    },

    "coupons": {
      ".indexOn": ["isActive"],
      ".read": "auth != null",
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'ADMIN'",
        ".validate": "newData.hasChildren(['code', 'discountPercent', 'isActive'])",

        "code": {
          ".validate": "newData.val() === $code"
        },
        "discountPercent": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "isActive": {
          ".validate": "newData.isBoolean()"
        },
        "expiryDate": {
          ".validate": "!newData.exists() || newData.val() == null || newData.isNumber() || newData.isString()"
        },
        "assignedUserId": {
          ".validate": "!newData.exists() || newData.val() == null || newData.isString()"
        }
      }
    },

    "menus": {
      ".read": "auth != null",
      "$menu_id": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'VENDOR' || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')"
      }
    }
  }
}